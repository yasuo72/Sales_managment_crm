# Zudio Store Insight Engine — Environment Variables Template
# Copy this file to .env and insert your API key.
# If no key is provided, the application will automatically run using its 
# robust deterministic fallback engine with zero crashes.

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
